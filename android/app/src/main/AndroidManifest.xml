<?xml version="1.0" encoding="utf-8"?>
<!-- No INTERNET permission: Android itself keeps LinkPilot offline. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- To hand links to its own copy in the work profile (Android 11+, "connected work & personal
         apps"); it does nothing until it is allowed. Lint calls it system-only, but it is an app-op
         permission: the "connected apps" switch grants it. Profiles.kt -->
    <uses-permission
        android:name="android.permission.INTERACT_ACROSS_PROFILES"
        tools:ignore="ProtectedPermissions" />

    <!-- Which apps it may see: the browsers (to list them and hand links on) and the apps on the
         home screen (to pick one for an app rule). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinkPilot">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- a long press on one of its Quick Settings tiles opens the app -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Every link, as the default browser: cleaned, then handed on to the chosen browser. -->
        <activity
            android:name=".LinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.LinkPilot.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Share a link to it: the clean link is copied. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/share_label"
            android:theme="@style/Theme.LinkPilot.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- In the work profile: opens a link handed over from the personal profile. -->
        <activity
            android:name=".ProfileOpenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.LinkPilot.Invisible" />

        <!-- The moment on screen "Clean copied link" needs to read what was copied. -->
        <activity
            android:name=".CleanClipboardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.LinkPilot.Invisible" />

        <!-- Copied links cleaned by themselves - only while switched on, in LinkPilot and in
             Android's Accessibility settings. CopyWatch.kt -->
        <service
            android:name=".CopyWatchService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/copy_watch" />
        </service>

        <service
            android:name=".CleanTile"
            android:exported="true"
            android:icon="@drawable/ic_t_link"
            android:label="@string/tile_clean"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home-screen widgets, and the list the "Choose browser" one shows. -->
        <receiver
            android:name=".NextWidget"
            android:exported="true"
            android:label="@string/tile_next">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next" />
        </receiver>

        <receiver
            android:name=".ChooseWidget"
            android:exported="true"
            android:label="@string/tile_choose">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_choose" />
        </receiver>

        <activity
            android:name=".ChooseActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.LinkPilot.Invisible" />

        <service
            android:name=".NextTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_next"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".ChooseTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_choose"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>

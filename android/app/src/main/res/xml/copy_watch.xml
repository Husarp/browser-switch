<?xml version="1.0" encoding="utf-8"?>
<!-- LinkPilot's accessibility service (CopyWatch.kt): it hears only the system's own screen parts
     (com.android.systemui) - never other apps - and cannot read what is on screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.android.systemui"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="50"
    android:canRetrieveWindowContent="false"
    android:description="@string/copy_watch_description" />